{
  "name": "@gatehook/oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "dev:cli": "tsx --env-file-if-exists=.env src/dev/cli.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@gatehook/sdk": "workspace:*",
    "@solana/kit": "8.4.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@solana-program/token-2022": "0.19.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "litesvm": "1.5.0",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  }
}
