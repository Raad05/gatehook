# Copy to .env and adjust; `pnpm start` and `pnpm dev:cli` load it automatically.
PORT=8787
HOST=127.0.0.1
# docker compose up -d  -> postgres on 127.0.0.1:${ORACLE_PG_PORT:-5434}; or pglite://.pglite for embedded
DATABASE_URL=postgres://gatehook:gatehook@127.0.0.1:5434/gatehook_oracle
RPC_URL=http://127.0.0.1:8899
WS_URL=ws://127.0.0.1:8900
# Must equal Registry.oracle for REGISTRY
ORACLE_KEYPAIR=~/.config/solana/id.json
REGISTRY=
# openssl rand -hex 32
API_KEY=
KYC_PROVIDER=mock
MOCK_WEBHOOK_SECRET=
KYC_VALIDITY_DAYS=365
EXPIRY_WARNING_DAYS=30
