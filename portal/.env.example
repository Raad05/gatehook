# Portal server. Copy to .env.
PORT=8788
ORACLE_URL=http://127.0.0.1:8787
# Same value as the oracle's API_KEY. Stays on the server.
ORACLE_API_KEY=
# Mint this portal serves (devnet demo: E2p6riTZ82UnDQuLCi1jEc4F1Pc8kZE36exCTJ198Gc1)
PORTAL_MINT=
CLUSTER=devnet
# RPC_URL=https://api.devnet.solana.com

# DEMO ONLY - never set in production:
# same as the oracle's MOCK_WEBHOOK_SECRET; enables the "Complete KYC" button
DEMO_MOCK_WEBHOOK_SECRET=
# issuer keypair; enables the faucet (0.01 SOL + 100 tokens to linked wallets)
DEMO_FAUCET_KEYPAIR=~/.config/solana/id.json
